server {
    listen 80 default_server;
    server_name _;

    root /opt/tru-track/dashboard;
    index index.html;

    access_log /var/log/nginx/tru-track-access.log;
    error_log  /var/log/nginx/tru-track-error.log warn;

    client_max_body_size 10m;

    location = / {
        try_files /index.html =404;
    }

    location = /fleet {
        try_files /fleet.html =404;
    }

    location = /login {
        try_files /login.html =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /tuning {
        auth_basic "TRU-TRACK Dev";
        auth_basic_user_file /etc/nginx/.tuning_htpasswd;
        proxy_pass         http://127.0.0.1:9001;
        proxy_set_header   Host $host;
        proxy_read_timeout 120s;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
